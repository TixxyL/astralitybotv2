WEB_ENABLED=false
WEB_PORT=3000
WEB_TOKEN=cambia-esta-clave
# Token del bot (Discord Developer Portal > Bot > Token). Ya lo tienes en tu .env real, no lo toques.
TOKEN=
PORT=3001

# ID de la aplicación (Discord Developer Portal > General Information > Application ID).
CLIENT_ID=1375606402957185114

# Opcional: si lo defines, los comandos se registran solo en ese servidor y se
# actualizan al instante (ideal para pruebas). Si lo dejas vacío, se registran
# globalmente y pueden tardar hasta 1 hora en aparecer.
GUILD_ID=

# Canal de Discord donde se publican todos los logs.
LOG_CHANNEL_ID=1377130076612726944

# IDs de usuario separados por coma que siempre pueden usar comandos de
# moderación/admin, sin importar sus roles.
ADMIN_IDS=686773772811894792,1143305402994413739

# Mención que se publica al abrir un ticket nuevo (usuario <@ID> o rol <@&ID>).
TICKET_PING=<@1373837000406466600>
TICKET_CATEGORY_NAME=TICKETS
# IDs de roles que pueden ver, responder, reclamar y cerrar tickets.
TICKET_STAFF_ROLE_IDS=ID_DEL_ROL_STAFF,ID_DEL_ROL_MODERACION

# Moderación automática: 5 mensajes en 7 segundos activa un timeout.
AUTOMOD_ENABLED=true
AUTOMOD_BLOCK_LINKS=true
AUTOMOD_MAX_MESSAGES=5
AUTOMOD_INTERVAL_MS=7000
AUTOMOD_TIMEOUT_MINUTES=5
# Dominios permitidos separados por comas, sin https:// (ejemplo.com, youtube.com).
AUTOMOD_ALLOWED_DOMAINS=
# Palabras separadas por comas. Si no lo defines, usa una lista básica en español.
AUTOMOD_BLOCKED_WORDS=

# IA Gemini. Obtén la clave en Google AI Studio y no la compartas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_PROMPT_LENGTH=2000
GEMINI_MAX_OUTPUT_TOKENS=700
GEMINI_COOLDOWN_MS=10000

# Datos de tu servidor de Minecraft para /ip.
SERVER_IP=play.astrality.net
SERVER_PORT=25565
SERVER_VERSION=1.20.x - 1.21.x (Java y Bedrock)
